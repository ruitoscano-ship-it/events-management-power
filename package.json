{
  "name": "events-management-power",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:supabase": "node --env-file=.env scripts/test-supabase.mjs",
    "db:migrate": "node --env-file=.env scripts/run-supabase-sql.mjs",
    "db:reset": "node --env-file=.env scripts/db-reset.mjs",
    "cache:reset-local": "node -e \"console.log('No browser: DevTools → Application → Local Storage → apagar chaves eventflow-* ou usar Atualizar do servidor na app.')\"",
    "pages:env": "node --env-file=.env scripts/configure-pages-env.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=events-management-power",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name=events-management-power --branch=preview"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.2.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "pg": "^8.21.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wrangler": "^4.14.0"
  }
}
